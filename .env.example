# Sistem Multi-Kedai — contoh environment
# Salin ke .env.local lalu isi dengan nilai dari project Supabase klien ini.
# Satu klien = satu project Supabase = satu deployment Vercel (lihat Tech.md).

# --- Supabase ---------------------------------------------------------
# Dashboard Supabase > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: HANYA dipakai di server (endpoint sync, eksekusi mutasi
# stok, rekonsiliasi shift, sesi karyawan QR). Jangan pernah diprefix
# NEXT_PUBLIC_ dan jangan pernah diimpor ke komponen client.
SUPABASE_SERVICE_ROLE_KEY=

# Connection string Postgres -- HANYA untuk menjalankan migration dari mesin
# developer (`npx supabase db push --db-url "$SUPABASE_DB_URL"`).
# Tidak dipakai aplikasi saat runtime, tidak perlu diisi di Vercel.
#
# Ambil dari: Dashboard > Project Settings > Database > Connection string >
# Session pooler. ("Direct connection" host-nya IPv6-only dan gagal dari
# banyak koneksi.) Password wajib percent-encoded kalau ada karakter spesial.
SUPABASE_DB_URL=

# --- Identitas instance ----------------------------------------------
# Ditampilkan di UI (halaman masuk, header admin).
NEXT_PUBLIC_CLIENT_NAME="Nama Bisnis Klien"

# --- Midtrans QRIS (M1-10/M1-11) --------------------------------------
# Wajib terisi di production HANYA kalau QRIS dipakai: tanpa key, sistem
# berjalan dalam mode mock (demo/dev) dan di production justru ditolak oleh
# kode (lihat lib/payment/midtrans.ts). Untuk klien Malaysia, Midtrans QRIS
# out of scope (lihat Tasks.md) -- biarkan kosong.
MIDTRANS_SERVER_KEY=
# sandbox | production. Kosongkan untuk default production.
MIDTRANS_ENV=sandbox